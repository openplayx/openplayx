# Copy the settings you need into the shared ../design/.env (relative to the openplayx app directory) (git-ignored).
# Run both cases: flutter test tool/source_services/cover_probe_test.dart
# SMB address must include the share; credentials belong in separate fields.
COVER_PROBE_SMB_ADDRESS=smb://smb.example.test/media
COVER_PROBE_SMB_USER=
COVER_PROBE_SMB_PASSWORD=
# Match the ResourceRef path expected by your SMB source, including its share.
COVER_PROBE_MEDIA_PATH=/media/test_video.mp4

# Second case (required): configure its address, path and credentials too.
COVER_PROBE_2_SMB_ADDRESS=smb://smb.example.test/another-share
COVER_PROBE_2_SMB_USER=
COVER_PROBE_2_SMB_PASSWORD=
COVER_PROBE_2_MEDIA_PATH=/another-share/sample.mp4

# Optional overrides; the default library uses the sibling FFmpeg host build,
# and output goes to opx-cover-probe under the system temporary directory.
# COVER_PROBE_FFMPEG_LIBRARY=/absolute/path/to/libopenplayx_ffmpeg.dylib
# COVER_PROBE_OUTPUT_DIR=/absolute/path/to/temporary/output
